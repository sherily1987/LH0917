# Server-side only. Mint at https://console.typesafe.ai
# Do not expose this key to the browser.
TYPESAFE_API_KEY=

# Optional. The /desk agent is paper-only.
# Live orders stay off unless all three are set, and this build still
# refuses to send them. No withdrawal permission. Do not commit real keys.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
DESK_LIVE_ARM=
