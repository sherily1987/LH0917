# Server-side only. Mint at https://console.typesafe.ai
# Do not expose this key to the browser.
TYPESAFE_API_KEY=

# --- 自动交易机器人 ---
# Grok 通过 Vercel AI Gateway 调用。部署在 Vercel 上会自动走 OIDC，本地需要填密钥。
AI_GATEWAY_API_KEY=
BOT_MODEL=spacexai/grok-4.7

# paper = 模拟盘（默认），live = 真实下单
BOT_MODE=paper
# 设为 false 立即停止所有自动交易
BOT_ENABLED=true
BOT_PAPER_CASH=10000

# 硬性风控（占总净值的比例）
BOT_MAX_ORDER_PCT=0.1
BOT_MAX_POSITION_PCT=0.3
BOT_MIN_CASH_PCT=0.2
BOT_MAX_DAILY_LOSS_PCT=0.05
BOT_MAX_DRAWDOWN_PCT=0.2
BOT_MIN_ORDER_USD=10

# 实盘交易所（ccxt 交易所 id，如 okx / bybit / coinbase；币安对美国 IP 返回 451，Vercel 默认区域在美国）
BOT_EXCHANGE=okx
BOT_QUOTE=USDT
# 默认走交易所测试网，确认无误后再改成 false
BOT_EXCHANGE_SANDBOX=true
# 只开「交易」权限，关闭「提现」，并绑定 IP 白名单
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# OKX 等需要 passphrase 的交易所
EXCHANGE_API_PASSWORD=

# 持久化：Vercel Marketplace 的 Upstash Redis 会自动注入这两个变量
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Cron 调用 /api/bot/tick 时携带的密钥
CRON_SECRET=
