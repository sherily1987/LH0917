# Server-side only. Mint at https://console.typesafe.ai
# Do not expose this key to the browser.
TYPESAFE_API_KEY=

# Optional OKX USDT perpetual. Server-side only. Trade permission, no withdrawal.
# Leave DESK_LIVE_ARM empty for the paper desk.
# DESK_LIVE_ARM=1 and OKX_SIMULATED=1 send OKX demo orders.
# DESK_LIVE_ARM=1 and OKX_SIMULATED=0 send real orders.
# Orders still stay off unless the last 14 days pass the cost-aware gate.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
DESK_LIVE_ARM=
OKX_SIMULATED=
